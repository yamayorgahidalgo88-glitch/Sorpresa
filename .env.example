# Copia este archivo como .env (no se sube a GitHub) o pon las variables en Vercel.
# Sin ninguna clave la web funciona igual; solo la prueba de corte con IA queda desactivada.

# Proveedor de la prueba de corte: fal (recomendado) o nvidia
TRYON_PROVIDER=fal

# fal.ai → FLUX.1 Kontext [pro]: acepta fotos subidas. Pago por imagen.
FAL_KEY=

# NVIDIA (build.nvidia.com). Ojo: la API alojada de prueba de FLUX.1 Kontext
# solo acepta sus imágenes de ejemplo, no fotos subidas. Para fotos reales
# hace falta un NIM propio y poner su URL en NVIDIA_ENDPOINT.
NVIDIA_API_KEY=
NVIDIA_ENDPOINT=
