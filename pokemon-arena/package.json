{
  "name": "pokemon-arena",
  "version": "0.1.0",
  "private": true,
  "description": "Juego de estrategia en tiempo real con cartas y Pokémon (proyecto de fans, no comercial).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/e2e.mjs",
    "simulate": "vite-node scripts/simulate.ts"
  },
  "dependencies": {
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vite-node": "5.3.0",
    "vitest": "4.1.12"
  }
}
