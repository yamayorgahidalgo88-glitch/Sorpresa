{
  "name": "pokemon-arena",
  "version": "0.1.0",
  "private": true,
  "description": "Juego de estrategia en tiempo real con cartas y Pokémon (proyecto de fans, no comercial).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/e2e.mjs",
    "simulate": "vite-node scripts/simulate.ts",
    "balance": "vite-node scripts/balance.ts",
    "captura:referencia": "vite build && node scripts/captura_referencia.mjs",
    "datos:pokeapi": "node scripts/pokeapi_datos.mjs"
  },
  "dependencies": {
    "@fontsource/lilita-one": "5.3.0",
    "@fontsource/nunito": "5.3.0",
    "phaser": "3.90.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/three": "0.186.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vite-node": "5.3.0",
    "vitest": "4.1.12"
  }
}
