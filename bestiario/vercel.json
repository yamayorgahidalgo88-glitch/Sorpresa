{
  "headers": [
    { "source": "/assets/models/(.*)", "headers": [
      { "key": "Content-Type", "value": "application/octet-stream" },
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Cache-Control", "value": "no-transform, public, max-age=0, must-revalidate" }
    ] }
  ]
}
